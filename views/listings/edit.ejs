<%layout("/layouts/boilerplate") -%>

    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h3 class="">Edit Your listing</h3>
            <form method="post" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate>

                <div class="mb-3 mt-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" type="text" value="<%=listing.title%>" id="title" class="form-control"
                        required>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">Please add the title</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="mb-3">Description</label>
                    <textarea name="listing[description]" type="text" class="form-control" id="description"
                        required><%=listing.description%></textarea>
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please add a small description</div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label">Image URL</label>
                    <input name="listing[image][url]" class="form-control" id="image" type="text"
                        value="<%=listing.image.url%>" required>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">Please add new url or keep the default url!</div>
                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input class="form-control" name="listing[price]" type="number" id="price"
                            value="<%=listing.price%>" required>
                        <div class="valid-feedback">Looks Good!</div>
                        <div class="invalid-feedback">Please add price</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input class="form-control" id="country" name="listing[country]" type="text"
                            value="<%=listing.country%>" required>
                        <div class="valid-feedback">Looks Good!</div>
                        <div class="invalid-feedback">Please add a valid country</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input class="form-control" id="location" name="listing[location]" type="text"
                        value="<%=listing.location%>" required>
                    <div class="valid-feedback">Looks Good!</div>
                    <div class="invalid-feedback">Please add a valid location </div>
                </div>

                <button class="btn btn-dark edit-btn mt-3">Edit this listing</button>
            </form>
        </div>
    </div>